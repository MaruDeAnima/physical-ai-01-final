<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="ai_robot">
    <pose>0 0 0.2 0 0 0</pose>
    <link name="base_link">
      <sensor name="front_lidar" type="gpu_lidar">
        <pose>0.3 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/scan</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>181</samples>
              <min_angle>-1.57</min_angle>
              <max_angle>1.57</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.03</ixx>
          <iyy>0.05</iyy>
          <izz>0.06</izz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.6 0.4 0.2</size>
          </box>
        </geometry>
      </collision>
      <visual name="ufo_body">
        <pose>0 0 0.08 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.38</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.95 0.88 0.72 1</ambient>
          <diffuse>0.95 0.88 0.72 1</diffuse>
        </material>
      </visual>
      <visual name="ufo_dome">
        <pose>0 0 0.16 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.22</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.96 0.92 0.82 1</ambient>
          <diffuse>0.96 0.92 0.82 1</diffuse>
        </material>
      </visual>
      <visual name="ufo_blue_glow">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.34</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.55 1 1</ambient>
          <diffuse>0.05 0.55 1 1</diffuse>
        </material>
      </visual>
      <visual name="ufo_dark_base">
        <pose>0 0 -0.045 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.29</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.12 1</ambient>
          <diffuse>0.08 0.08 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="alien_body">
        <pose>0 0 0.35 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.12</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.85 1</ambient>
          <diffuse>0.82 0.82 0.85 1</diffuse>
        </material>
      </visual>
      <visual name="alien_head">
        <pose>0 0 0.60 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.23</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.85 1</ambient>
          <diffuse>0.82 0.82 0.85 1</diffuse>
        </material>
      </visual>
      <visual name="alien_left_eye">
        <pose>0.195 0.095 0.62 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.075</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.04 1</ambient>
          <diffuse>0.02 0.02 0.04 1</diffuse>
        </material>
      </visual>
      <visual name="alien_right_eye">
        <pose>0.195 -0.095 0.62 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.075</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.04 1</ambient>
          <diffuse>0.02 0.02 0.04 1</diffuse>
        </material>
      </visual>
      <visual name="alien_left_arm">
        <pose>0.02 0.16 0.38 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.075</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.85 1</ambient>
          <diffuse>0.82 0.82 0.85 1</diffuse>
        </material>
      </visual>
      <visual name="alien_right_arm">
        <pose>0.02 -0.16 0.38 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.075</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.85 1</ambient>
          <diffuse>0.82 0.82 0.85 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="left_wheel">
      <pose>0 0.25 -0.1 -1.5708 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.002</ixx>
          <iyy>0.002</iyy>
          <izz>0.002</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.25 -0.1 -1.5708 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.002</ixx>
          <iyy>0.002</iyy>
          <izz>0.002</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.5</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <topic>/cmd_vel</topic>
    </plugin>
  </model>
</sdf>